rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function isAuth()     { return request.auth != null; }
    function userDoc()    { return get(/databases/$(db)/documents/accounts/$(request.auth.uid)).data; }
    function isActive()   { return isAuth() && userDoc().status == "Active"; }
    function isManager()  { return isActive() && userDoc().type == "Manager"; }
    function isEmployee() { return isActive() && userDoc().type == "Employee"; }
    function isSelf(uid)  { return isAuth() && request.auth.uid == uid; }

    // ---------- Accounts ----------
    match /accounts/{uid} {
      allow read: if isSelf(uid) || isManager();
      allow create: if isSelf(uid)
                    && request.resource.data.type == "Employee"
                    && request.resource.data.status == "Pending";
      // Self may update only profile fields; never elevate own type/status.
      allow update: if isManager()
                    || (isSelf(uid)
                        && request.resource.data.type   == resource.data.type
                        && request.resource.data.status == resource.data.status);
      allow delete: if isManager();
    }

    // ---------- Profiles ----------
    // Fiche partagée : nom, téléphone, photo. Rien d'autre n'a le droit d'atterrir ici.
    // C'est ce qui permet à un responsable du jour non-admin de voir son équipe sans que
    // /accounts — qui porte l'IBAN et l'adresse — s'ouvre à quiconque.
    match /profiles/{uid} {
      allow read:  if isActive();
      allow write: if isSelf(uid) || isManager();
    }

    // ---------- Job roles ----------
    match /jobRoles/{id} {
      allow read:  if isActive();
      allow write: if isManager();
    }

    // ---------- Events ----------
    // v1 simplification: any Active user reads all events (UI filters by assignment/open).
    // Write is manager-only. Tighter rule deferred to v2.
    match /events/{eventId} {
      allow read:  if isActive();
      allow write: if isManager();
    }

    // ---------- Assignments ----------
    match /assignments/{id} {
      function eventOf(eid) {
        return get(/databases/$(db)/documents/events/$(eid)).data;
      }
      // Le responsable du jour est désigné sur l'event, pas porté par le compte.
      function isResponsableOf(eid) {
        return isEmployee() && eventOf(eid).responsableAccountId == request.auth.uid;
      }

      // v1 simplification, identique à /events : tout compte actif lit, l'UI filtre.
      // Une règle conditionnelle serait plus étroite mais déclencherait un get() par document,
      // et Firestore plafonne à 20 get() par requête — un event d'une dizaine de personnes
      // ferait échouer la requête entière.
      allow read:   if isActive();

      allow create: if isManager()
                    || (isEmployee()
                        && request.resource.data.accountId == request.auth.uid
                        && request.resource.data.source    == "SelfRequest"
                        && request.resource.data.status    == "PendingApproval");

      // Chacun projette son propre état de service sur son affectation — c'est ce qui permet
      // au responsable de voir l'équipe sans lire les timesheets des autres. La présence est
      // autorisée en écriture ici, mais uniquement vers "Present" : démarrer son service
      // prouve qu'on est là, alors que pouvoir se déclarer absent couvrirait une défection.
      function estSonAffectation() {
        return isEmployee() && resource.data.accountId == request.auth.uid;
      }
      function nAToucheQueSonService() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['shift', 'shiftSince', 'presence'])
               && (request.resource.data.presence == resource.data.presence
                   || request.resource.data.presence == 'Present');
      }

      // Le responsable ne peut toucher que le pointage, jamais le reste de l'assignation.
      // FirestoreDataService écrit via setDoc : diff() ne retient que les valeurs qui
      // changent réellement, donc hasOnly(['presence']) reste satisfait.
      allow update: if isManager()
                    || (isResponsableOf(resource.data.eventId)
                        && request.resource.data.diff(resource.data)
                               .affectedKeys().hasOnly(['presence']))
                    || (estSonAffectation() && nAToucheQueSonService());

      allow delete: if isManager();
    }

    // ---------- Timesheets ----------
    // Employees own a timesheet if its assignment belongs to them.
    function isMyAssignment(assignmentId) {
      let a = get(/databases/$(db)/documents/assignments/$(assignmentId)).data;
      return a.accountId == request.auth.uid;
    }

    // L'event d'une affectation, et le responsable du jour qui y est désigné.
    function eventOfAssignment(assignmentId) {
      let a = get(/databases/$(db)/documents/assignments/$(assignmentId)).data;
      return get(/databases/$(db)/documents/events/$(a.eventId)).data;
    }

    // Le responsable pilote les compteurs de son équipe, mais pas indéfiniment : passé 48 h
    // après la fin du service, seul un admin corrige encore. La comparaison s'appuie sur
    // endsAt, un vrai Timestamp — la date et les horaires sont stockés en texte et les règles
    // ne savent pas les convertir. Un event antérieur à ce champ reste pilotable : le refuser
    // condamnerait tout l'historique, et l'admin le complète dès qu'il ouvre la fiche.
    function isResponsableDansLaFenetre(assignmentId) {
      let ev = eventOfAssignment(assignmentId);
      return isEmployee()
             && ev.responsableAccountId == request.auth.uid
             && (!('endsAt' in ev) || request.time < ev.endsAt + duration.value(48, 'h'));
    }

    match /timesheets/{id} {
      allow read:   if isManager()
                    || (isEmployee() && (isMyAssignment(resource.data.assignmentId)
                                         || isResponsableDansLaFenetre(resource.data.assignmentId)));
      allow create: if isManager()
                    || (isEmployee() && (isMyAssignment(request.resource.data.assignmentId)
                                         || isResponsableDansLaFenetre(request.resource.data.assignmentId)));
      allow update: if isManager()
                    || (isEmployee() && (isMyAssignment(resource.data.assignmentId)
                                         || isResponsableDansLaFenetre(resource.data.assignmentId)));
      allow delete: if isManager();
    }
  }
}
