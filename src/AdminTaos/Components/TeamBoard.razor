@inject IDataService Data
@inject AuthState Auth
@implements IDisposable

@* Le tableau de l'équipe, sans le décor de page : la fiche d'un event l'affiche en ligne dès
   que le service a commencé, et la page /equipe l'affiche pour le responsable du jour. Un seul
   composant pour les deux, sinon les deux divergent au premier correctif. *@

@if (_loading)
{
    <div class="panel"><div class="m">Chargement…</div></div>
}
else if (_team.Count == 0)
{
    <div class="panel"><div class="m">Personne n'est encore assigné sur cet event.</div></div>
}
else
{
    <div class="panel">
        <div class="m presence-count">@Present présent@(Present > 1 ? "s" : "") · @Absent absent@(Absent > 1 ? "s" : "") · @Expected attendu@(Expected > 1 ? "s" : "")</div>
        @if (Event.Status == EventStatus.InProgress)
        {
            <div class="m shift-tally" style="margin-top:6px">@Compte(ShiftState.InService) en service · @Compte(ShiftState.OnBreak) en pause · @Compte(ShiftState.NotStarted) pas commencé · @Compte(ShiftState.Finished) terminé</div>
        }
    </div>

    @if (_verrouille)
    {
        <p class="pill wait" style="display:block;margin:12px 0">Passé 48 h après la fin du service, seul un admin peut encore corriger les heures.</p>
    }

    @if (_err is not null) { <p class="pill bad" style="display:block;margin:12px 0">@_err</p> }

    @foreach (var group in _team.GroupBy(m => m.RoleId))
    {
        <div class="lab">@RoleName(group.Key)@TargetSuffix(group.Key, group.Count())</div>
        @foreach (var m in group)
        {
            <div class="panel team-member" data-account-id="@m.Profile.Id">
                <div style="display:flex;align-items:center;gap:14px">
                    @if (!string.IsNullOrWhiteSpace(m.Profile.PhotoUrl))
                    {
                        <img class="team-avatar" src="@m.Profile.PhotoUrl" alt="@m.Profile.FullName"
                             style="width:48px;height:48px;border-radius:50%;object-fit:cover;border:1px solid var(--line)" />
                    }
                    else
                    {
                        <div class="team-initials"
                             style="width:48px;height:48px;border-radius:50%;background:var(--goldbg);color:var(--gold);display:flex;align-items:center;justify-content:center;font-family:var(--pf);font-weight:700">@Initials(m.Profile.FullName)</div>
                    }
                    <div style="flex:1">
                        <div class="t">@m.Profile.FullName</div>
                        @if (string.IsNullOrWhiteSpace(m.Profile.Phone))
                        {
                            <div class="m">Téléphone non renseigné</div>
                        }
                        else
                        {
                            <div class="m"><a class="team-phone" href="@TelHref(m.Profile.Phone)">@m.Profile.Phone</a></div>
                        }
                    </div>
                </div>
                <div style="margin-top:10px">
                    <span class="@m.Asg.Shift.PillClass() shift-state">@m.Asg.Shift.StatusFr()</span>
                    @if (m.Asg.ShiftSince is { } depuis)
                    {
                        <span class="m" style="margin-left:8px">depuis @depuis.Fmt()@Ecoule(m.Asg)</span>
                    }
                </div>
                @if (_pilote)
                {
                    <div class="pilot" style="margin-top:10px">
                        @if (_saisieHeure == m.Asg.Id)
                        {
                            <div class="field">
                                <span>Heure de début</span>
                                <input class="pilot-start-time" type="time"
                                       value="@_heure.ToString("HH\\:mm")" @onchange="OnHeure" />
                            </div>
                            <div class="row2" style="margin-top:8px">
                                <button class="btn ghost" @onclick="() => _saisieHeure = null">Annuler</button>
                                <button class="btn primary pilot-start-confirm"
                                        @onclick="() => Demarrer(m.Asg)">Démarrer</button>
                            </div>
                        }
                        else if (m.Asg.Shift == ShiftState.NotStarted)
                        {
                            @if (ShiftOps.CanStart(m.Asg))
                            {
                                <button class="btn ghost pilot-start" @onclick="() => OuvrirSaisie(m.Asg)">Démarrer son service</button>
                            }
                            else
                            {
                                <div class="m">Marqué absent. Repasse-le présent s'il est finalement arrivé.</div>
                            }
                        }
                        else if (m.Asg.Shift == ShiftState.InService)
                        {
                            <div class="row2">
                                <button class="btn ghost pilot-pause" @onclick="() => Piloter(m.Asg, Geste.Pause)">Mettre en pause</button>
                                <button class="btn ghost pilot-finish" @onclick="() => Piloter(m.Asg, Geste.Fin)">Terminer</button>
                            </div>
                        }
                        else if (m.Asg.Shift == ShiftState.OnBreak)
                        {
                            <div class="row2">
                                <button class="btn ghost pilot-resume" @onclick="() => Piloter(m.Asg, Geste.Reprise)">Reprendre</button>
                                <button class="btn ghost pilot-finish" @onclick="() => Piloter(m.Asg, Geste.Fin)">Terminer</button>
                            </div>
                        }
                    </div>
                }
                @if (RowAction is not null)
                {
                    <div style="margin-top:10px">@RowAction(m.Asg)</div>
                }
                <div class="row2" style="margin-top:10px">
                    <button class="btn @(m.Asg.Presence == PresenceStatus.Present ? "primary" : "ghost") presence-present"
                            @onclick="() => SetPresence(m.Asg, PresenceStatus.Present)">Présent</button>
                    <button class="btn @(m.Asg.Presence == PresenceStatus.Absent ? "danger" : "ghost") presence-absent"
                            @onclick="() => SetPresence(m.Asg, PresenceStatus.Absent)">Absent</button>
                </div>
            </div>
        }
    }
}

@code {
    [Parameter, EditorRequired] public ServiceEvent Event { get; set; } = default!;

    /// <summary>Action propre à l'hôte, rendue sur chaque ligne. La fiche admin y met « Retirer » ;
    /// la page du responsable n'en fournit aucune — il ne retire personne.</summary>
    [Parameter] public RenderFragment<Assignment>? RowAction { get; set; }

    public record Member(Profile Profile, Assignment Asg, string RoleId);

    List<Member> _team = new();
    Dictionary<string,string> _roleNames = new();
    Dictionary<string,Profile> _profiles = new();
    bool _loading = true;
    string? _err;

    enum Geste { Pause, Reprise, Fin }

    bool _pilote;        // l'utilisateur peut agir sur les compteurs de l'équipe
    bool _verrouille;    // responsable au-delà de la fenêtre de 48 h
    string? _saisieHeure;
    TimeOnly _heure;
    System.Threading.Timer? _refresh;

    protected override async Task OnInitializedAsync()
    {
        _roleNames = (await Data.GetJobRolesAsync()).ToDictionary(r => r.Id, r => r.Name);

        // On lit /profiles et jamais /accounts : un responsable non-admin n'a pas le droit de
        // lire les comptes, et une requête refusée échoue en entier — le tableau serait vide.
        _profiles = (await Data.GetProfilesAsync()).ToDictionary(p => p.Id);

        var moi = Auth.CurrentUser;
        _pilote = ShiftOps.CanPilot(moi, Event);
        _verrouille = !_pilote && moi is not null && moi.Id == Event.ResponsableAccountId;

        await RefreshAsync();
        await ReconcileAsync();
        _loading = false;

        // Une vue du soir qui ne bouge pas ment : « en service » affiché pour quelqu'un parti
        // depuis vingt minutes est pire que pas d'écran. On n'interroge que pendant l'event.
        if (Event.Status == EventStatus.InProgress)
            _refresh = new System.Threading.Timer(
                _ => InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); }),
                null, 30_000, 30_000);
    }

    public void Dispose() => _refresh?.Dispose();

    /// <summary>
    /// Relit les seules affectations. Rôles métier et fiches partagées ne bougent pas pendant
    /// un service : les relire toutes les 30 secondes multiplierait la facture Firestore
    /// pour rien.
    /// </summary>
    public async Task RefreshAsync()
    {
        _team = (await Data.GetAssignmentsForEventAsync(Event.Id))
            .Where(a => a.Status == AssignmentStatus.Confirmed)
            .Select(a => new Member(Known(_profiles, a.AccountId), a, a.JobRoleId))
            .OrderBy(m => m.Profile.FullName)
            .ToList();
    }

    /// <summary>
    /// Répare les projections périmées à partir des timesheets. Réservé à l'admin, seul à
    /// pouvoir les lire : un service démarré avant l'arrivée de cette projection, ou resté
    /// désynchronisé, s'afficherait « pas commencé » pour tout le monde. Une fois réparé, le
    /// responsable en profite sans jamais lire la moindre heure.
    /// </summary>
    async Task ReconcileAsync()
    {
        if (Auth.CurrentUser?.Type != AccountType.Manager || _team.Count == 0) return;

        try
        {
            var feuilles = (await Data.GetTimesheetsAsync()).ToDictionary(t => t.AssignmentId);
            foreach (var m in _team)
                await ShiftSync.ApplyAsync(Data, m.Asg, feuilles.GetValueOrDefault(m.Asg.Id));
        }
        catch
        {
            // La réparation est un confort : son échec ne doit pas vider l'écran du responsable.
        }
    }

    // TryParse explicite plutôt que @bind : la liaison de TimeOnly sur un input time laisse
    // passer une saisie non reconnue sans rien dire, et l'ancienne valeur part en base.
    void OnHeure(ChangeEventArgs e)
    { if (TimeOnly.TryParse(e.Value?.ToString(), out var t)) _heure = t; }

    void OuvrirSaisie(Assignment a)
    {
        _err = null;
        _saisieHeure = a.Id;
        _heure = TimeOnly.FromDateTime(DateTime.Now);   // proposée, et modifiable
    }

    /// <summary>
    /// Démarre le service de quelqu'un à l'heure saisie. L'heure passée est le cas normal :
    /// on s'aperçoit à 19h30 que la personne a commencé à 17h et n'a rien lancé.
    /// </summary>
    async Task Demarrer(Assignment a)
    {
        _err = null;
        try
        {
            var debut = ShiftOps.InstantDansLeService(_heure, Event);
            await ShiftOps.StartAsync(Data, a, debut, Auth.CurrentUser?.Id);
            _saisieHeure = null;
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            _err = $"Échec du démarrage : {ex.Message}";
        }
    }

    async Task Piloter(Assignment a, Geste geste)
    {
        _err = null;
        try
        {
            var ts = await Data.GetTimesheetForAssignmentAsync(a.Id);
            if (ts is null) { _err = "Aucune feuille d'heures pour cette personne."; return; }

            var par = Auth.CurrentUser?.Id;
            switch (geste)
            {
                case Geste.Pause:   await ShiftOps.PauseAsync(Data, a, ts, par); break;
                case Geste.Reprise: await ShiftOps.ResumeAsync(Data, a, ts, par); break;
                case Geste.Fin:     await ShiftOps.FinishAsync(Data, a, ts, par); break;
            }
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            _err = $"Échec de l'opération : {ex.Message}";
        }
    }

    /// <summary>Personne ne disparaît de la liste faute de fiche partagée.</summary>
    static Profile Known(Dictionary<string,Profile> profiles, string accountId) =>
        profiles.TryGetValue(accountId, out var p)
            ? p
            : new Profile { Id = accountId, FullName = "Profil incomplet" };

    int Compte(ShiftState s) => _team.Count(m => m.Asg.Shift == s);

    /// <summary>« (2h10) » à côté de l'heure, pour lire la durée sans faire le calcul.</summary>
    string Ecoule(Assignment a)
    {
        if (a.Shift is ShiftState.NotStarted or ShiftState.Finished || a.ShiftSince is not { } d)
            return "";
        var ecoule = DateTime.Now - d;
        return ecoule < TimeSpan.Zero ? "" : $" ({ecoule.FmtShort()})";
    }

    string RoleName(string id) => _roleNames.GetValueOrDefault(id, "Rôle inconnu");

    /// <summary>« · 3 / 4 » quand l'event déclare un effectif pour ce rôle, rien sinon.</summary>
    string TargetSuffix(string roleId, int assigned)
    {
        var need = Event.RoleNeeds.FirstOrDefault(n => n.JobRoleId == roleId);
        return need is null ? "" : $" · {assigned} / {need.CountNeeded}";
    }

    static string Initials(string fullName)
        => string.Concat(fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2).Select(p => char.ToUpperInvariant(p[0])));

    int Present  => _team.Count(m => m.Asg.Presence == PresenceStatus.Present);
    int Absent   => _team.Count(m => m.Asg.Presence == PresenceStatus.Absent);
    int Expected => _team.Count(m => m.Asg.Presence == PresenceStatus.Expected);

    async Task SetPresence(Assignment a, PresenceStatus status)
    {
        _err = null;
        var previous = a.Presence;
        try
        {
            a.Presence = status;
            await Data.UpdateAssignmentAsync(a);
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            a.Presence = previous;   // l'écran ne doit pas montrer un pointage qui n'a pas été écrit
            _err = $"Échec du pointage : {ex.Message}";
        }
    }

    /// <summary>Un lien tel: ne tolère pas les espaces de mise en forme du numéro.</summary>
    static string TelHref(string phone)
        => "tel:" + new string(phone.Where(c => !char.IsWhiteSpace(c)).ToArray());
}
