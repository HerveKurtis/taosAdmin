@page "/pending"
@inject AuthState Auth
@inject NavigationManager Nav

<div class="empty" style="padding:20px 0">
    <div class="ic">⏳</div>
    <div class="e-t">Inscription en attente</div>
    <p>Une fois que ton inscription sera validée par un admin, tu pourras te connecter sur le portail.</p>
</div>

<button class="btn primary block" style="margin-top:24px" @onclick="GoToLogin">Se connecter</button>

@code {
    async Task GoToLogin()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("login", replace: true);
    }
}
