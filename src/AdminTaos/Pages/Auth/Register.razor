@page "/register"
@inject IDataService Data
@inject AuthState Auth
@inject NavigationManager Nav

<h1>Créer un compte</h1>
<p class="sub">Ton compte sera validé par un admin avant l'accès.</p>

<div class="stacked row2">
    <div>
        <span class="lbl">Prénom</span>
        <input @bind="_firstName" placeholder="Prénom" autocomplete="given-name" />
    </div>
    <div>
        <span class="lbl">Nom</span>
        <input @bind="_lastName" placeholder="Nom" autocomplete="family-name" />
    </div>
</div>
<div class="stacked">
    <span class="lbl">Email</span>
    <input @bind="_email" placeholder="ton.email@exemple.com" type="email" autocomplete="email" />
</div>
<div class="stacked">
    <span class="lbl">Mot de passe</span>
    <input @bind="_pwd" type="password" placeholder="Minimum 6 caractères" autocomplete="new-password" />
</div>

@if (_roles.Count > 0)
{
    <div class="lab">Rôle(s) souhaité(s) — optionnel</div>
    <p class="sub" style="margin-top:0;font-size:11.5px">L'admin pourra ajuster ton rôle après validation.</p>
    @foreach (var r in _roles)
    {
        <button class="card @(_selected.Contains(r.Id) ? "glow" : "")" @onclick="() => Toggle(r.Id)">
            <div class="t">@r.Name</div>
            <div class="m">@(_selected.Contains(r.Id) ? "Sélectionné ✓" : "Toucher pour choisir")</div>
        </button>
    }
}
else
{
    <div class="lab">Rôle</div>
    <p class="sub" style="margin-top:0;font-size:11.5px">Ton rôle sera défini par l'admin lors de la validation de ton compte.</p>
}

@if (_err) { <p class="pill bad" style="display:block;text-align:center;margin-top:10px">@_errMessage</p> }

<button class="btn primary block" @onclick="Submit">S'inscrire</button>
<a class="btn ghost block" href="login">‹ Retour à la connexion</a>

@code {
    List<JobRole> _roles = new();
    readonly HashSet<string> _selected = new();
    string _firstName = "", _lastName = "", _email = "", _pwd = "";
    bool _err;
    string _errMessage = "Remplis prénom, nom, email et mot de passe.";

    protected override async Task OnInitializedAsync() => _roles = await Data.GetJobRolesAsync();

    void Toggle(string id) { if (!_selected.Add(id)) _selected.Remove(id); }

    async Task Submit()
    {
        _err = false;
        if (string.IsNullOrWhiteSpace(_firstName)
            || string.IsNullOrWhiteSpace(_lastName)
            || string.IsNullOrWhiteSpace(_email)
            || string.IsNullOrWhiteSpace(_pwd))
        {
            _err = true;
            _errMessage = "Remplis prénom, nom, email et mot de passe.";
            return;
        }

        var fullName = $"{_firstName.Trim()} {_lastName.Trim()}";
        var ok = await Auth.RegisterAsync(fullName, _email.Trim(), _pwd, _selected.ToList());
        if (!ok)
        {
            _err = true;
            _errMessage = "Cet email est déjà utilisé ou l'inscription a échoué.";
            return;
        }
        Nav.NavigateTo("pending", replace: true);
    }
}
