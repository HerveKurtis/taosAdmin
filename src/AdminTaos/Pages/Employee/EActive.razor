@page "/e/events/{Id}/active"
@layout DashboardLayout
@inject IDataService Data
@inject AuthState Auth
@inject NavigationManager Nav

@if (_e is not null && _ts is not null)
{
    <h1>Shift en cours</h1>
    <div class="panel" style="text-align:center;max-width:480px;margin:0 auto">
        <div class="t">@_e.Name</div>
        <div class="m">@_e.Venue · @RoleName</div>
        @if (_ts.IsOnBreak)
        {
            <Chrono Since="_ts.OpenBreak!.StartedAt" />
            <div class="live paused">● EN PAUSE — DEPUIS @_ts.OpenBreak.StartedAt.Fmt()</div>
            <div class="m shift-meta">Temps presté @WorkedSoFar().Fmt() · pause cumulée @_ts.RecordedBreak.FmtShort()</div>
            <button class="btn primary block shift-resume" @onclick="ResumeShift">Reprendre le service</button>
            <button class="btn ghost block shift-finish" @onclick="Finish">Terminer mon shift</button>
        }
        else
        {
            <Chrono Since="_ts.StartedAt!.Value" Deduct="_ts.RecordedBreak" />
            <div class="live">● EN SERVICE — DÉBUT @_ts.StartedAt.Fmt()</div>
            @if (_ts.RecordedBreak > TimeSpan.Zero)
            {
                <div class="m shift-meta">Pause cumulée : @_ts.RecordedBreak.FmtShort()</div>
            }
            <button class="btn ghost block shift-break" @onclick="StartBreak">Prendre une pause</button>
            <button class="btn primary block shift-finish" @onclick="Finish">Terminer mon shift</button>
        }
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";
    ServiceEvent? _e;
    Timesheet? _ts;
    Assignment? _asg;
    string RoleName = "";

    protected override async Task OnInitializedAsync()
    {
        // Le garde de navigation redirige, mais la page peut être rendue avant : ne pas lever.
        if (Auth.CurrentUser is not { } u) return;
        _e = await Data.GetEventAsync(Id);
        _asg = (await Data.GetAssignmentsForAccountAsync(u.Id)).FirstOrDefault(a => a.EventId == Id);
        if (_asg is { } asg)
        {
            _ts = await Data.GetTimesheetForAssignmentAsync(asg.Id);
            // Rattrapage : une affectation antérieure à cette fonctionnalité, ou restée
            // désynchronisée, retrouve son état réel dès que l'écran s'ouvre.
            await ShiftSync.ApplyAsync(Data, asg, _ts);
            RoleName = (await Data.GetJobRolesAsync())
                .FirstOrDefault(r => r.Id == asg.JobRoleId)?.Name ?? "";
        }
    }

    Task SyncShift() => _asg is null ? Task.CompletedTask : ShiftSync.ApplyAsync(Data, _asg, _ts);

    /// <summary>Temps presté à cet instant. Pendant une pause il est figé à l'entrée en pause.</summary>
    TimeSpan WorkedSoFar()
    {
        var until = _ts!.OpenBreak?.StartedAt ?? DateTime.Now;
        var worked = until - _ts.StartedAt!.Value - _ts.RecordedBreak;
        return worked < TimeSpan.Zero ? TimeSpan.Zero : worked;
    }

    async Task StartBreak()
    {
        if (_ts!.IsOnBreak) return;
        _ts.Breaks.Add(new ShiftBreak { StartedAt = DateTime.Now });
        await Data.UpdateTimesheetAsync(_ts);
        await SyncShift();
    }

    async Task ResumeShift()
    {
        if (_ts!.OpenBreak is not { } open) return;
        open.EndedAt = DateTime.Now;
        await Data.UpdateTimesheetAsync(_ts);
        await SyncShift();
    }

    async Task Finish()
    {
        var end = DateTime.Now;
        // Terminer pendant une pause la referme à l'heure de fin : personne ne reste en pause.
        if (_ts!.OpenBreak is { } open) open.EndedAt = end;
        _ts.EndedAt = end;
        _ts.Status = TimesheetStatus.ToSend;
        await Data.UpdateTimesheetAsync(_ts);
        await SyncShift();
        Nav.NavigateTo($"e/events/{Id}/recap");
    }
}
