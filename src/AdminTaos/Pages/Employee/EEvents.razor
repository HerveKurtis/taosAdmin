@page "/e/events"
@layout DashboardLayout
@inject IDataService Data
@inject AuthState Auth
@inject NavigationManager Nav

<h1>Events</h1>

<div class="lab">Mes events</div>
@{ var _mineCols = new List<ResponsiveTable<ServiceEvent>.Column> {
    new("Event", e => @<b>@e.Name</b>),
    new("Date", e => @<text>@e.Date.Fmt()</text>),
    new("Lieu", e => @<text>@e.Venue</text>)
}; }
<ResponsiveTable TItem="ServiceEvent" Items="_mine"
    EmptyIcon="◷" EmptyTitle="Aucun event assigné"
    RowClick="@(e => Nav.NavigateTo($"e/events/{e.Id}"))"
    Columns="_mineCols" />

<div class="lab">Events ouverts à rejoindre</div>
@{ var _openCols = new List<ResponsiveTable<ServiceEvent>.Column> {
    new("Event", e => @<b>@e.Name</b>),
    new("Date", e => @<text>@e.Date.Fmt()</text>),
    new("Lieu", e => @<text>@e.Venue · ouvert</text>)
}; }
<ResponsiveTable TItem="ServiceEvent" Items="_open"
    EmptyIcon="◷" EmptyTitle="Aucun event ouvert"
    RowClick="@(e => Nav.NavigateTo($"e/events/{e.Id}"))"
    Columns="_openCols" />

@code {
    List<ServiceEvent> _mine = new(), _open = new();
    protected override async Task OnInitializedAsync()
    {
        // Le garde de navigation redirige, mais la page peut être rendue avant : ne pas lever.
        if (Auth.CurrentUser is not { } u) return;
        var events = await Data.GetEventsAsync();
        var myAsg = await Data.GetAssignmentsForAccountAsync(u.Id);
        var myEventIds = myAsg.Select(a => a.EventId).ToHashSet();
        _mine = events.Where(e => myEventIds.Contains(e.Id)).ToList();
        _open = events.Where(e => e.IsOpenForSignup && e.Status != EventStatus.Past
                                   && !myEventIds.Contains(e.Id)).ToList();
    }
}
