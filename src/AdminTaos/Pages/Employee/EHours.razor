@page "/e/hours"
@layout DashboardLayout
@inject IDataService Data
@inject AuthState Auth
@inject NavigationManager Nav

<h1>Mes heures</h1>
@{ var _hoursCols = new List<ResponsiveTable<(Timesheet ts, ServiceEvent ev)>.Column> {
    new("Event", r => @<b>@r.ev.Name</b>),
    new("Date", r => @<text>@r.ev.Date.Fmt()</text>),
    new("Durée", r => @<text>@r.ts.Duration.Fmt()</text>),
    new("Statut", r => @<span class="@r.ts.Status.PillClass()">@r.ts.Status.StatusFr()</span>)
}; }
<ResponsiveTable TItem="(Timesheet ts, ServiceEvent ev)" Items="_rows"
    EmptyIcon="≣" EmptyTitle="Aucune prestation" EmptyHint="Tes timesheets apparaîtront ici."
    RowClick="@(r => Nav.NavigateTo($"e/hours/{r.ts.Id}"))"
    Columns="_hoursCols" />

@code {
    List<(Timesheet ts, ServiceEvent ev)> _rows = new();
    protected override async Task OnInitializedAsync()
    {
        // Le garde de navigation redirige, mais la page peut être rendue avant : ne pas lever.
        if (Auth.CurrentUser is not { } u) return;
        var asgs = await Data.GetAssignmentsForAccountAsync(u.Id);
        var events = await Data.GetEventsAsync();
        foreach (var a in asgs)
        {
            var ts = await Data.GetTimesheetForAssignmentAsync(a.Id);
            var ev = events.FirstOrDefault(e => e.Id == a.EventId);
            if (ts is null || ev is null) continue;
            // Seul écran du collaborateur qui regarde ses events passés : c'est donc ici qu'un
            // service oublié se referme de son côté. L'accueil ne liste que les events à venir.
            await ShiftOps.FermerAutoSiNecessaireAsync(Data, a, ts, ev);
            _rows.Add((ts, ev));
        }
        _rows = _rows.OrderByDescending(r => r.ev.Date).ToList();
    }
}
