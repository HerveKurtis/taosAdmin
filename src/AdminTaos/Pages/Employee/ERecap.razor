@page "/e/events/{Id}/recap"
@layout DashboardLayout
@inject IDataService Data
@inject AuthState Auth
@inject NavigationManager Nav

@if (_e is not null && _ts is not null)
{
    <h1>Shift terminé</h1>
    <div class="panel" style="max-width:540px">
        <div class="lab" style="margin-top:0">Récapitulatif</div>
        <p style="font-size:15px;line-height:1.9;color:var(--txt)">
            <b>Event @_e.Name</b> · @_e.Date.Fmt() · Rôle @RoleName<br/>
            Service de <b>@_ts.StartedAt.Fmt()</b> à <b>@_ts.EndedAt.Fmt()</b>,
            soit <b>@_ts.GrossDuration.Fmt()</b> d'amplitude.<br/>
            @if (_ts.EffectiveBreak > TimeSpan.Zero)
            {
                <text>Pause : <b>@_ts.EffectiveBreak.FmtShort()</b> (@BreakLabel())<br/></text>
            }
            Temps presté : <b style="color:var(--gold)">@_ts.Duration.Fmt()</b>
        </p>
        <div style="margin:14px 0">
            <span class="@_ts.Status.PillClass()">@_ts.Status.StatusFr()</span>
        </div>
        @if (_ts.Status == TimesheetStatus.ToSend)
        {
            <button class="btn primary block" @onclick="Send">Envoyer ma timesheet pour validation</button>
            <p class="m" style="text-align:center;margin-top:10px">Le manager la recevra pour validation.</p>
        }
        else
        {
            <p class="pill ok" style="display:block;text-align:center">Timesheet envoyée pour validation ✓</p>
            <NavLink class="btn ghost block" style="margin-top:10px" href="e/hours">Voir mes heures</NavLink>
        }
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";
    ServiceEvent? _e;
    Timesheet? _ts;
    string RoleName = "";

    protected override async Task OnInitializedAsync()
    {
        // Le garde de navigation redirige, mais la page peut être rendue avant : ne pas lever.
        if (Auth.CurrentUser is not { } u) return;
        _e = await Data.GetEventAsync(Id);
        var asg = (await Data.GetAssignmentsForAccountAsync(u.Id)).FirstOrDefault(a => a.EventId == Id);
        if (asg is not null)
        {
            _ts = await Data.GetTimesheetForAssignmentAsync(asg.Id);
            RoleName = (await Data.GetJobRolesAsync())
                .FirstOrDefault(r => r.Id == asg.JobRoleId)?.Name ?? "";
        }
    }

    string BreakLabel() => _ts!.Breaks.Count <= 1 ? "1 pause" : $"{_ts.Breaks.Count} pauses";

    async Task Send()
    {
        _ts!.Status = TimesheetStatus.Sent;
        _ts.SentAt = DateTime.Now;
        await Data.UpdateTimesheetAsync(_ts);
    }
}
