@page "/m/events/{Id}/assign"
@layout DashboardLayout
@inject IDataService Data
@inject NavigationManager Nav

<button class="backlink" @onclick='() => Nav.NavigateTo($"m/events/{Id}")'>‹ Détail event</button>
<h1>Assigner du personnel</h1>
<p class="sub">@_event?.Name</p>

@if (_err is not null) { <p class="pill bad" style="display:block;margin:12px 0">@_err</p> }

@if (_loading)
{
    <div class="panel"><div class="m">Chargement…</div></div>
}
else if (_event is null)
{
    <div class="panel"><p class="sub">Event introuvable.</p></div>
}
else if (_roles.Count == 0)
{
    <div class="panel">
        <div class="t">Aucun collaborateur assignable</div>
        <div class="m">Aucun collaborateur actif ne porte de rôle métier. Attribue-en un depuis la fiche d'un membre de l'équipe.</div>
        <NavLink class="btn primary block" style="margin-top:12px" href="m/team">Voir l'équipe</NavLink>
    </div>
}
else
{
    @foreach (var r in _roles)
    {
        var candidates = _employees.Where(e => e.JobRoleIds.Contains(r.Id)).ToList();
        var assignedHere = _assigned.Count(a => a.JobRoleId == r.Id);
        var target = Target(r.Id);
        <div class="lab">@r.Name</div>
        @if (target is not null)
        {
            <p class="sub" style="margin-top:-4px">@assignedHere / @target assigné(s)</p>
        }
        @if (candidates.Count == 0)
        {
            <div class="panel">
                <div class="m">Aucun collaborateur actif ne porte ce rôle métier. Attribue-le depuis la fiche d'un membre de l'équipe.</div>
                <NavLink class="btn ghost block" style="margin-top:12px" href="m/team">Voir l'équipe</NavLink>
            </div>
        }
        @foreach (var emp in candidates)
        {
            var already = _assigned.Any(a => a.AccountId == emp.Id && a.JobRoleId == r.Id);
            <div class="panel" style="display:flex;justify-content:space-between;align-items:center;gap:12px">
                <div><div class="t">@emp.FullName</div>
                    <div class="m">@(already ? "Déjà assigné" : "Disponible")</div></div>
                @if (!already)
                {
                    <button class="btn primary" @onclick="() => Assign(emp.Id, r.Id)">Assigner</button>
                }
            </div>
        }
    }
}

@code {
    [Parameter] public string Id { get; set; } = "";
    ServiceEvent? _event;
    List<Account> _employees = new();
    List<JobRole> _roles = new();
    List<Assignment> _assigned = new();
    bool _loading = true;
    string? _err;

    protected override async Task OnInitializedAsync() => await Load();

    async Task Load()
    {
        _event = await Data.GetEventAsync(Id);
        if (_event is null) { _loading = false; return; }

        var allRoles = await Data.GetJobRolesAsync();
        _employees = (await Data.GetAccountsAsync())
            .Where(a => a.Type == AccountType.Employee && a.Status == AccountStatus.Active).ToList();

        // The effectif is a planning target, not a gate: when the event declares one we follow it,
        // otherwise we offer every rôle métier someone active actually holds.
        _roles = _event.RoleNeeds.Count > 0
            ? allRoles.Where(r => _event.RoleNeeds.Any(n => n.JobRoleId == r.Id)).ToList()
            : allRoles.Where(r => _employees.Any(e => e.JobRoleIds.Contains(r.Id))).ToList();

        _assigned = await Data.GetAssignmentsForEventAsync(Id);
        _loading = false;
    }

    /// <summary>How many people this event wants on that role, or null when no effectif is declared.</summary>
    int? Target(string roleId) =>
        _event?.RoleNeeds.FirstOrDefault(n => n.JobRoleId == roleId)?.CountNeeded;

    async Task Assign(string accId, string roleId)
    {
        _err = null;
        try
        {
            await Data.CreateAssignmentAsync(new Assignment {
                EventId = Id, AccountId = accId, JobRoleId = roleId,
                Source = AssignmentSource.AssignedByManager, Status = AssignmentStatus.Confirmed });
            await Load();
        }
        catch (Exception ex)
        {
            // A silent no-op here is what made this page impossible to diagnose from the outside.
            _err = $"Échec de l'assignation : {ex.Message}";
        }
    }
}
