@page "/m/events/{Id}"
@layout DashboardLayout
@inject IDataService Data
@inject NavigationManager Nav

<button class="backlink" @onclick='() => Nav.NavigateTo("m/events")'>‹ Events</button>

@if (_e is null)
{
    <div class="panel"><p class="sub">Introuvable.</p></div>
}
else
{
    <h1>@_e.Name</h1>
    <div class="panel">
        <div class="m">@_e.Venue — @_e.Address<br/>@_e.Date.Fmt() · @_e.MeetingTime.Fmt() → @_e.ExpectedEndTime.Fmt()
        @if (_responsable is not null)
        {
            <text><br/>Responsable du jour : @_responsable.FullName@(string.IsNullOrWhiteSpace(_responsable.Phone) ? "" : $" — {_responsable.Phone}")</text>
        }
        else if (!string.IsNullOrWhiteSpace(_e.OnSiteContact))
        {
            <text><br/>Contact : @_e.OnSiteContact</text>
        }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_e.Instructions))
    {
        <div class="lab">Consignes</div>
        <div class="panel consignes">
            <p>@_e.Instructions</p>
        </div>
    }

    @if (_e.RoleNeeds.Count > 0)
    {
        <div class="lab">Effectif par rôle</div>
        <div class="panel">
            @foreach (var rn in _e.RoleNeeds)
            {
                var c = _confirmed.Count(a => a.JobRoleId == rn.JobRoleId);
                <div class="field"><span>@RoleName(rn.JobRoleId)</span>
                    <b>@c / @rn.CountNeeded assigné(s)</b></div>
            }
        </div>
    }

    @* Pendant le service, le tableau d'équipe porte déjà ce décompte : pas deux fois. *@
    @if (_confirmed.Count > 0 && _e.Status != EventStatus.InProgress)
    {
        <div class="lab">Présences</div>
        <div class="panel">
            <div class="m presence-tally">@PresentCount présent@(PresentCount > 1 ? "s" : "") · @AbsentCount absent@(AbsentCount > 1 ? "s" : "") · @ExpectedCount attendu@(ExpectedCount > 1 ? "s" : "")</div>
        </div>
    }

    @if (_e.Status != EventStatus.InProgress)
    {
    <div class="lab">Personnel assigné</div>
    @if (_confirmed.Count == 0)
    {
        <div class="panel"><div class="m">Personne pour l'instant</div></div>
    }
    else
    {
        @if (_removeErr is not null) { <p class="pill bad" style="display:block;margin:12px 0">@_removeErr</p> }
        <div class="panel">
        @foreach (var a in _confirmed)
        {
            <div class="field">
                <span>@Name(a.AccountId)</span>
                <b style="display:flex;align-items:center;gap:10px">
                    @RoleName(a.JobRoleId)
                    <button class="btn ghost asg-remove" style="padding:4px 10px;font-size:12px"
                            @onclick="() => AskRemove(a)">Retirer</button>
                </b>
            </div>
            @if (_removing?.Id == a.Id)
            {
                <div class="panel" style="margin:10px 0">
                    <div class="m">Retirer @Name(a.AccountId) de cet event ? L'assignation sera supprimée.</div>
                    <div class="row2" style="margin-top:12px">
                        <button class="btn ghost asg-remove-cancel" @onclick="() => _removing = null">Annuler</button>
                        <button class="btn danger asg-remove-confirm" @onclick="ConfirmRemove">Retirer</button>
                    </div>
                </div>
            }
        }
        </div>
    }

    }
    else
    {
        @* Le service tourne : une seule liste, qui porte le suivi et le retrait. *@
        <div class="lab">Équipe du jour</div>
        @if (_removeErr is not null) { <p class="pill bad" style="display:block;margin:12px 0">@_removeErr</p> }
        <TeamBoard Event="_e" RowAction="RetirerBouton" />
    }

    @if (_requests.Count > 0)
    {
        <div class="lab">Demandes de participation</div>
        @foreach (var a in _requests)
        {
            <div class="panel">
                <div class="t">@Name(a.AccountId)</div>
                <div class="m">@RoleName(a.JobRoleId) · demande à rejoindre</div>
                <div class="row2" style="margin-top:12px">
                    <button class="btn danger" @onclick="() => Decide(a, false)">Refuser</button>
                    <button class="btn primary" @onclick="() => Decide(a, true)">Accepter</button>
                </div>
            </div>
        }
    }

    @* On prépare avant, on pilote pendant : l'action mise en avant suit l'état de l'event.
       Les deux restent atteignables — on complète parfois une équipe en plein service. *@
    <div class="actions">
        <NavLink class="@ActionBtn(EventStatus.Upcoming)"
                 href="@($"m/events/{_e.Id}/assign")">Assigner du personnel</NavLink>
        <NavLink class="@ActionBtn(EventStatus.InProgress)"
                 href="@($"m/events/{_e.Id}/equipe")">Équipe du jour</NavLink>
        <NavLink class="btn ghost" href="@($"m/events/{_e.Id}/edit")">Éditer l'event</NavLink>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";
    ServiceEvent? _e;
    List<Assignment> _confirmed = new(), _requests = new();
    Dictionary<string,string> _names = new(), _roles = new();
    Account? _responsable;
    Assignment? _removing;
    string? _removeErr;

    protected override async Task OnInitializedAsync() => await Load();

    async Task Load()
    {
        _e = await Data.GetEventAsync(Id);
        _responsable = string.IsNullOrEmpty(_e?.ResponsableAccountId)
            ? null
            : await Data.GetAccountAsync(_e.ResponsableAccountId);
        _names = (await Data.GetAccountsAsync()).ToDictionary(a => a.Id, a => a.FullName);
        _roles = (await Data.GetJobRolesAsync()).ToDictionary(r => r.Id, r => r.Name);
        var asgs = await Data.GetAssignmentsForEventAsync(Id);
        _confirmed = asgs.Where(a => a.Status == AssignmentStatus.Confirmed).ToList();
        _requests  = asgs.Where(a => a.Status == AssignmentStatus.PendingApproval).ToList();
    }

    /// <summary>Le retrait, rendu par le tableau d'équipe pendant le service. Le responsable,
    /// lui, n'en reçoit aucun : il ne retire personne.</summary>
    RenderFragment<Assignment> RetirerBouton => a => @<text>
        @if (_removing?.Id == a.Id)
        {
            <div class="m">Retirer @Name(a.AccountId) de cet event ? L'assignation sera supprimée.</div>
            <div class="row2" style="margin-top:8px">
                <button class="btn ghost asg-remove-cancel" @onclick="() => _removing = null">Annuler</button>
                <button class="btn danger asg-remove-confirm" @onclick="ConfirmRemove">Retirer</button>
            </div>
        }
        else
        {
            <button class="btn ghost asg-remove" style="padding:4px 10px;font-size:12px"
                    @onclick="() => AskRemove(a)">Retirer</button>
        }
    </text>;

    /// <summary>Met en avant l'action qui correspond au moment où se trouve l'event.</summary>
    string ActionBtn(EventStatus quand) => _e?.Status == quand ? "btn primary" : "btn ghost";

    int PresentCount  => _confirmed.Count(a => a.Presence == PresenceStatus.Present);
    int AbsentCount   => _confirmed.Count(a => a.Presence == PresenceStatus.Absent);
    int ExpectedCount => _confirmed.Count(a => a.Presence == PresenceStatus.Expected);

    string Name(string id) => _names.GetValueOrDefault(id, "?");
    string RoleName(string id) => _roles.GetValueOrDefault(id, "?");

    void AskRemove(Assignment a) { _removeErr = null; _removing = a; }

    async Task ConfirmRemove()
    {
        if (_removing is not { } a) return;

        // Supprimer une assignation orphelinerait la feuille d'heures qui la référence :
        // une fois le service démarré, on corrige les heures, on ne fait pas disparaître la personne.
        var ts = await Data.GetTimesheetForAssignmentAsync(a.Id);
        if (ts?.StartedAt is not null)
        {
            _removeErr = $"{Name(a.AccountId)} a déjà démarré son service : ses heures seraient perdues. Corrige plutôt sa timesheet.";
            _removing = null;
            return;
        }

        await Data.DeleteAssignmentAsync(a.Id);
        _removing = null;
        await Load();
    }

    async Task Decide(Assignment a, bool accept)
    {
        a.Status = accept ? AssignmentStatus.Confirmed : AssignmentStatus.Rejected;
        await Data.UpdateAssignmentAsync(a);
        await Load();
    }
}
