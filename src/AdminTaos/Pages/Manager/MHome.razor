@page "/m"
@layout DashboardLayout
@inject IDataService Data
@inject NavigationManager Nav

<h1>À traiter</h1>
<p class="sub">Tableau de bord manager</p>

<div class="stats">
    <StatCard Value="@_pendingAccounts.ToString()" Label="Comptes à valider" Href="m/team?filter=pending" />
    <StatCard Value="@_joinRequests.ToString()" Label="Demandes de participation" Href="m/events" />
    <StatCard Value="@_pendingTimesheets.ToString()" Label="Timesheets à valider" Href="m/timesheets" />
    <StatCard Value="@_upcomingCount.ToString()" Label="Events à venir" Href="m/events" />
</div>

<div class="lab">Comptes à valider</div>
<div class="card"><div class="m">@_pendingAccountNames</div></div>

@{ var _upcomingCols = new List<ResponsiveTable<ServiceEvent>.Column> {
    new("Event", e => @<b>@e.Name</b>),
    new("Date", e => @<text>@e.Date.Fmt()</text>),
    new("Lieu", e => @<text>@e.Venue</text>),
    new("Statut", e => @<span class="@e.Status.PillClass()">@e.Status.StatusFr()</span>)
}; }

<div class="lab">Events en cours et à venir</div>
@if (_upcoming.Count == 0)
{
    <div class="card"><div class="m">Aucun event en cours ni à venir</div></div>
}
else
{
    <ResponsiveTable TItem="ServiceEvent" Items="_upcoming"
        RowClick="@(e => Nav.NavigateTo($"m/events/{e.Id}"))"
        Columns="_upcomingCols" />
}

@code {
    int _pendingAccounts, _joinRequests, _pendingTimesheets;
    string _pendingAccountNames = "";
    List<ServiceEvent> _upcoming = new();
    int _upcomingCount;

    protected override async Task OnInitializedAsync()
    {
        var accs = await Data.GetAccountsAsync();
        var pend = accs.Where(a => a.Status == AccountStatus.Pending).ToList();
        _pendingAccounts = pend.Count;
        _pendingAccountNames = pend.Count == 0 ? "Aucun" : string.Join(" · ", pend.Select(a => a.FullName));

        var asgs = await Data.GetAssignmentsAsync();
        _joinRequests = asgs.Count(a => a.Status == AssignmentStatus.PendingApproval);

        var ts = await Data.GetTimesheetsAsync();
        _pendingTimesheets = ts.Count(t => t.Status == TimesheetStatus.Sent);

        var vivants = (await Data.GetEventsAsync())
            .Where(e => e.Status != EventStatus.Past).ToList();
        // Ce qui se déroule maintenant passe devant ce qui est prévu.
        _upcoming = vivants.OrderBy(e => e.Status == EventStatus.InProgress ? 0 : 1)
                           .ThenBy(e => e.Date).Take(5).ToList();
        _upcomingCount = vivants.Count(e => e.Status == EventStatus.Upcoming);
    }
}
